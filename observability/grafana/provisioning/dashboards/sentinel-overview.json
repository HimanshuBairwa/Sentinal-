{
  "title": "Sentinel — Fraud Decisioning Overview",
  "uid": "sentinel-overview",
  "timezone": "browser",
  "refresh": "15s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Risk Decisions by Action",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (action) (rate(sentinel_risk_decisions_total[5m]))",
          "legendFormat": "{{action}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Risk Score Distribution (avg)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rate(sentinel_risk_score_distribution_sum[5m])) / sum(rate(sentinel_risk_score_distribution_count[5m]))",
          "legendFormat": "mean score"
        }
      ],
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "ML Inference Latency p50/p99 (s)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(sentinel_ml_inference_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(sentinel_ml_inference_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "End-to-End Scoring Latency (avg s)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rate(sentinel_risk_processing_seconds_sum[5m])) / sum(rate(sentinel_risk_processing_seconds_count[5m]))",
          "legendFormat": "mean"
        }
      ],
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Gateway Throughput",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "rate(sentinel_gateway_proxied_total[5m])",
          "legendFormat": "proxied/s"
        },
        {
          "expr": "rate(sentinel_gateway_rate_limited_total[5m])",
          "legendFormat": "rate-limited/s"
        }
      ],
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 8 }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Model Loaded",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "sentinel_model_loaded", "legendFormat": "loaded" }],
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Kafka Auth Events Consumed",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "rate(sentinel_kafka_events_processed_total[5m])", "legendFormat": "events/s" }
      ],
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "schemaVersion": 39,
  "version": 1
}
